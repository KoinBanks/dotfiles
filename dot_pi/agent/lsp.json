{
  "version": 1,
  "servers": [
    {
      "id": "ts7",
      "enabled": true,
      "include": ["**/*.ts"],
      "rootMarkers": ["package.json"],
      "bin": "./node_modules/.bin/tsc",
      "args": ["--lsp", "--stdio"],
      "cwd": "{root}",
      "languageIdByExtension": { ".ts": "typescript" },
      "startupTimeoutMs": 45000,
      "diagnosticsWaitMs": 1500,
      "initializationOptions": {},
      "settings": {}
    }
  ]
}
